# ScholarHub Backend Environment Configuration Example
# Copy this file to .env and configure values before starting the backend server.

# Express Server Configuration
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scholarhub
DB_USER=postgres
DB_PASSWORD=replace_with_db_password
DB_POOL_MAX=20

# CORS Allowed Origins (comma-separated origins for production)
# Example: ALLOWED_ORIGINS=https://scholarhub.app,https://scholarhub-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# JWT Authentication
# IMPORTANT: In production, generate a strong random 256-bit secret (e.g. `openssl rand -base64 32`)
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=scholarhub-api
JWT_AUDIENCE=scholarhub-frontend

# Password Hashing Cost Factor
BCRYPT_ROUNDS=12

# Rate Limiting Configuration (requests per 15 minutes)
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Gmail SMTP Configuration for Automated Deadline Emails & Password OTPs
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Google Gemini AI API Key (Get key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key
