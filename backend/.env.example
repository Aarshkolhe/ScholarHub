# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scholarhub
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_MAX=20
PG_URI=postgres://postgres:your_postgres_password@localhost:5432/scholarhub

# Optional Mongo URI (if used for logging/analytics)
MONGO_URI=mongodb://localhost:27017/scholarhub

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1h
JWT_ISSUER=scholarhub-api
JWT_AUDIENCE=scholarhub-frontend

# Password Hashing
BCRYPT_ROUNDS=12

# Gmail SMTP Email Delivery
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Free Google Gemini AI API Key (Get your free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_free_gemini_api_key_here
