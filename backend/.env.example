# Server Configuration
PORT=5000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scholarhub
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_POOL_MAX=20
PG_URI=postgres://postgres:your_database_password@localhost:5432/scholarhub

# Optional Mongo URI
MONGO_URI=mongodb://localhost:27017/scholarhub

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1h
JWT_ISSUER=scholarhub-api
JWT_AUDIENCE=scholarhub-frontend

# Password Hashing
BCRYPT_ROUNDS=12

# Gmail SMTP Email Delivery
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
